{
  "mcpServers": {
    "device-screenshot": {
      "command": "/bin/sh",
      "args": ["-c", "exec \"${CODEX_MCP_NODE_PATH:-node}\" ./server.mjs"],
      "cwd": ".",
      "env_vars": ["CODEX_MCP_NODE_PATH", "PATH", "HOME", "TMPDIR", "ANDROID_HOME", "ANDROID_SDK_ROOT", "DEVELOPER_DIR"],
      "startup_timeout_sec": 15,
      "tool_timeout_sec": 90
    }
  }
}
